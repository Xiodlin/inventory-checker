{
  "name": "inventory-checker",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform inventory and sales tracker",
  "workspaces": [
    "backend",
    "mobile",
    "desktop",
    "shared"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "glob@>=9": "14.0.3",
    "minimatch@>=9": "11.0.3"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:mobile": "npm run dev --workspace mobile",
    "dev:desktop": "npm run dev --workspace desktop",
    "build": "npm run build --workspace shared && npm run build --workspace desktop",
    "typecheck": "npm run build --workspace shared && npm run typecheck --workspaces",
    "test": "npm run build --workspace shared && npm test --workspace shared && npm test --workspace backend",
    "db:migrate": "npm run migrate --workspace backend",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Xiodlin/inventory-checker.git"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true,
    "fsevents@2.3.3": true
  }
}
