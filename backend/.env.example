# PostgreSQL URL: user inventory, generated Docker password, localhost:5432,
# database inventory_checker. URL-encode password characters; do not commit credentials.
DATABASE_URL=
REDIS_URL=redis://localhost:6379
# Replace with a random secret of at least 32 characters (for example openssl rand -hex 32).
JWT_SECRET=
PORT=3000
# Explicit allowed origins for Vite and packaged Electron; no wildcard or cookies.
CORS_ORIGIN=http://localhost:5173,null,file://
CHECK_CRON=* * * * *
FIREBASE_ENABLED=false
# Optional integrations; without credentials checks explicitly report not configured.
BESTBUY_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
