{
  "name": "inventory-checker-desktop",
  "version": "1.0.0",
  "description": "Inventory Checker desktop client",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run build --workspace @inventory-checker/core && tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json",
    "dev": "npm run build && node scripts/dev.cjs",
    "dev:prepare": "npm run build && node scripts/dev.cjs --prepare",
    "start": "electron .",
    "test": "electron test/local-smoke.cjs && electron test/shopping-smoke.cjs",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never -c.mac.identity=-",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook"
  },
  "keywords": [],
  "author": "",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@inventory-checker/core": "1.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "storybook": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "vitest": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "playwright": "latest"
  }
}
