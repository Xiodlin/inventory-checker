{
  "name": "inventory-checker",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform inventory and sales tracker",
  "workspaces": ["backend", "mobile", "desktop"],
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "glob@>=9": "14.0.3",
    "minimatch@>=9": "11.0.3"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:mobile": "npm run dev --workspace mobile",
    "dev:desktop": "npm run dev --workspace desktop",
    "build": "npm run build --workspace backend && npm run build --workspace desktop",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspace backend",
    "db:migrate": "npm run migrate --workspace backend",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Xiodlin/inventory-checker.git"
  }
}
