{
  "name": "inventory-checker-desktop",
  "version": "1.0.0",
  "description": "Inventory Checker desktop client",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "package": "npm run build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "private": true,
  "type": "commonjs",
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
